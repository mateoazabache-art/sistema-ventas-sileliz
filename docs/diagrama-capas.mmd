---
title: Gestión de Ventas Sileliz.mas — Capas (servlet → servicio → DAO), código real 16 nov 2026
---
classDiagram
    direction LR

    class SesionFilter {
        <<filtro>>
        protege /api/…
        401 sin sesión
        403 sin permiso por rol
        415 si no es JSON
        +usuarioActual(req)$ Usuario
    }

    class LoginServlet {
        <<servlet>>
        POST /api/login
    }
    class VentaServlet {
        <<servlet>>
        /api/ventas/…
    }
    class IngresoServlet {
        <<servlet>>
        POST /api/ingresos
    }
    class ProductoServlet {
        <<servlet>>
        /api/productos/…
    }
    class VarianteServlet {
        <<servlet>>
        /api/variantes/…
    }
    class CategoriaServlet {
        <<servlet>>
        /api/categorias/…
    }
    class ClienteServlet {
        <<servlet>>
        /api/clientes/…
    }
    class UsuarioServlet {
        <<servlet>>
        /api/usuarios/…
    }
    class ReporteServlet {
        <<servlet>>
        /api/reportes/…
    }
    class EstadisticaServlet {
        <<servlet>>
        GET /api/estadisticas/hoy
    }

    class AuthService {
        +iniciarSesion(usuario, clave) Usuario
    }
    class VentaService {
        +BigDecimal TOPE_PORCENTAJE_VENDEDOR = 10$
        +registrar(VentaSolicitud, Usuario) Venta
        +buscarPorId(id, Usuario) Comprobante
        +listar(desde, hasta, pagina, tam, Usuario) Paginado
        +anular(id, motivo, Usuario) Comprobante
    }
    class IngresoService {
        +int CANTIDAD_MAXIMA = 999$
        +registrar(IngresoSolicitud, Usuario) IngresoRegistrado
    }
    class ProductoService {
        +registrar(Producto) Producto
        +actualizar(Producto) void
        +desactivar(id) void
        +listarPaginado(pagina, tam, texto, idCategoria) Paginado
    }
    class VarianteService {
        +registrar(VarianteProducto) VarianteProducto
        +listarPorProducto(idProducto) List
        +buscarPorTexto(texto) List
    }
    class CategoriaService {
        +registrar(Categoria) Categoria
        +actualizar(Categoria) void
        +desactivar(id) void
        +listarPaginado(pagina, tam, texto, activo) Paginado
    }
    class ClienteService {
        +listar(pagina, tam, texto) Paginado
        +buscarPorDni(dni) Cliente
        +registrar(Cliente) Cliente
        +actualizar(id, Cliente) Cliente
        +desactivar(id) void
    }
    class UsuarioService {
        +registrar(UsuarioSolicitud, Usuario) Usuario
        +actualizar(id, UsuarioSolicitud, Usuario) Usuario
        +restablecerClave(id, clave, Usuario) void
        +desactivar(id, Usuario) void
        +activar(id, Usuario) void
    }
    class ReporteService {
        +ventas(desde, hasta, pagina, tam) ReporteVentas
        +masVendidos(desde, hasta, limite) List
        +porVendedor(desde, hasta) List
    }

    class UsuarioDao {
